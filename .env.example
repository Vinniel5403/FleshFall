DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id
# Optional: register commands to one guild (instant) instead of global (up to 1h)
GUILD_ID=
DATA_FILE=data/db.json

# Crimson Moon override: auto (schedule) | on | off
CRIMSON_MOON=auto
# travel time between zones in minutes (default 30)
TRAVEL_MINUTES=30
# Discord role that skips limits (instant travel, free shop/upgrade/cook, no cooldowns/stamina)
GOD_ROLE=Dev

# Web API for the Next.js site (web/). Set to run it inside the bot with live data,
# or run it alone with `npm run api` (defaults to 3001, reads player data read-only).
# API_PORT=3001

# --- Website character creation (fleshfall.org/create → /api/account/* on this bot) ---
# Shared secret the website sends as "Authorization: Bearer <API_SECRET>". Needs API_PORT + GUILD_ID.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# API_SECRET=
# Website base URL — /start links here instead of creating characters in Discord
# WEB_URL=https://fleshfall.org
# 1 = kick members who join without a character (enable "Server Members Intent" in the dev portal first)
# REQUIRE_CHARACTER=0
# Public R2 URL (same as web R2_PUBLIC_URL) — profile card shows the player's uploaded art
# IMAGE_BASE_URL=https://img.fleshfall.org
