# Vercel → Project → Settings → Environment Variables (local: web/.env.local)

# Discord OAuth (same application as the bot). Portal → OAuth2 → Redirects:
#   https://fleshfall.org/api/auth/callback   (+ http://localhost:3000/api/auth/callback for dev)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional: pin the redirect URI (defaults to <request origin>/api/auth/callback)
# DISCORD_REDIRECT_URI=https://fleshfall.org/api/auth/callback

# Encrypts the login cookie. ≥32 random chars.
SESSION_SECRET=

# Bot account API on the VM (HTTPS!) + the bot's API_SECRET
BOT_API_URL=https://api.fleshfall.org
BOT_API_SECRET=

# Cloudflare R2 — API token with "Object Read & Write" on this bucket only
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fleshfall-images
# Bucket's public custom domain (R2 → bucket → Settings → Custom Domains)
R2_PUBLIC_URL=https://img.fleshfall.org
